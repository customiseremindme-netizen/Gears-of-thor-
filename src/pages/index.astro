---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import About from '../components/About.astro'
import Signature from '../components/Signature.astro'
import Training from '../components/Training.astro'
import Gallery from '../components/Gallery.astro'
import Membership from '../components/Membership.astro'
import Contact from '../components/Contact.astro'
import Closing from '../components/Closing.astro'
import Footer from '../components/Footer.astro'
import MobileBar from '../components/MobileBar.astro'
import { site } from '../content/site'

// Local business details for search engines: only publicly listed facts
// (no opening hours, prices or ratings until the owner confirms them).
const c = site.contact
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: site.brand.name,
  alternateName: site.brand.expanded,
  url: new URL('/', Astro.site).href,
  image: new URL('/og-image.jpg', Astro.site).href,
  logo: new URL('/icons/icon-512.png', Astro.site).href,
  telephone: c.phoneHref.replace('tel:', ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: c.address.street,
    addressLocality: c.address.locality,
    addressRegion: c.address.region,
    postalCode: c.address.postalCode,
    addressCountry: c.address.country,
  },
  sameAs: [c.instagramUrl],
}
---
<Base jsonLd={jsonLd}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <About />
    <Signature />
    <Training />
    <Gallery />
    <Membership />
    <Contact />
    <Closing />
  </main>
  <Footer />
  <MobileBar />
</Base>
