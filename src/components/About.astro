---
import Pic from './Pic.astro'
import SplitHeading from './SplitHeading.astro'
import SectionLabel from './SectionLabel.astro'
import Icon from './Icon.astro'
import { site } from '../content/site'
import { images } from '../content/images'
const a = site.about
const c = site.contact
---
<section class="about section" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <SectionLabel index={a.index} label={a.eyebrow} class="about__label" />
    <SplitHeading text={a.heading} class="display display--xl about__title" id="about-title" />

    <figure class="about__figure frame" data-reveal="image" data-slot="about-closeup" data-slot-brief={images['about-closeup'].brief}>
      <Pic name="about-closeup" sizes="(min-width: 1024px) 38vw, 92vw" class="frame__img" />
      <figcaption class="about__caption">{a.imageCaption}</figcaption>
    </figure>

    <div class="about__body">
      <p class="lead" data-reveal="up">{a.text}</p>
      <a class="text-link" href={a.link.href} data-reveal="up" style="--d:1">
        <span class="link-line">{a.link.label}</span><Icon name="arrow" />
      </a>
      <dl class="facts" data-reveal="up" style="--d:2">
        <div>
          <dt>Find us</dt>
          <dd>{c.address.street}<br />{c.address.locality}, {c.address.region} {c.address.postalCode}</dd>
        </div>
        <div>
          <dt>Call</dt>
          <dd><a class="link-line" href={c.phoneHref}>{c.phoneDisplay}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>
